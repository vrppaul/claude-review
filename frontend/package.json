{
  "name": "claude-review-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ && stylelint 'src/**/*.css'",
    "format": "prettier --write src tests '*.config.{js,ts}' knip.ts",
    "format:check": "prettier --check src tests '*.config.{js,ts}' knip.ts",
    "knip": "knip",
    "api:types": "uv run --project .. python -m claude_review.presentation.api_schema http | openapi-typescript -o src/lib/types/generated/http.ts && uv run --project .. python -m claude_review.presentation.api_schema socket | openapi-typescript -o src/lib/types/generated/socket.ts",
    "api:check": "uv run --project .. python -m claude_review.presentation.api_schema http | openapi-typescript --check -o src/lib/types/generated/http.ts && uv run --project .. python -m claude_review.presentation.api_schema socket | openapi-typescript --check -o src/lib/types/generated/socket.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "daisyui": "^5.5.19",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.0",
    "eslint-plugin-svelte": "^3.17.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.0.2",
    "knip": "^6.41.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.8.2",
    "prettier-plugin-svelte": "^3.5.1",
    "stylelint": "^17.16.0",
    "svelte": "^5.55.3",
    "svelte-check": "^4.4.6",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "marked": "^18.0.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.2.0"
  }
}
